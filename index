    <style>
        .min-panel-height { min-height: 520px; }
        input, button { touch-action: manipulation; }

        /* ANIMACIONES */
        .fade-in { animation: fadeIn 0.25s ease-in-out; }
        .slide-up { animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
        .btn-animate { transition: all 0.2s ease-in-out; }
        .btn-animate:hover { transform: translateY(-2px); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        .btn-animate:active { transform: translateY(0); }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

        /* CELDAS PENDIENTES (VERDE) */
        .cell-green-plan { background-color: #d1fae5 !important; border-color: #34d399 !important; color: #065f46 !important; font-weight: bold; }

        /* MODO OSCURO */
        body.dark-theme { background-color: #0b1329 !important; color: #e2e8f0 !important; }
        body.dark-theme header { background-color: #060913 !important; border-bottom: 1px solid #1e293b; }
        body.dark-theme .bg-white { background-color: #111b33 !important; border-color: #1e293b !important; color: #e2e8f0 !important; }
        body.dark-theme .bg-slate-100 { background-color: #0b1329 !important; }
        body.dark-theme .bg-slate-50, body.dark-theme .bg-slate-200 { background-color: #162241 !important; color: #e2e8f0 !important; }
        body.dark-theme .bg-slate-300 { background-color: #1e293b !important; color: #cbd5e1 !important; }
        body.dark-theme input, body.dark-theme select { background-color: #162241 !important; color: #ffffff !important; border-color: #2a3d6c !important; }
        body.dark-theme table th { background-color: #0f1c3f !important; color: #f8fafc !important; border-color: #1e293b !important; }
        body.dark-theme table td { border-color: #1e293b !important; color: #e2e8f0 !important; }
        body.dark-theme .text-slate-800, body.dark-theme .text-slate-700 { color: #f1f5f9 !important; }
        body.dark-theme .cell-green-plan { background-color: #064e3b !important; border-color: #059669 !important; color: #6ee7b7 !important; }
