    <script>
        const SUPABASE_URL = 'https://imwhfiznaetndbyuxkkx.supabase.co';
        const SUPABASE_ANON_KEY = 'sb_publishable_ZK0_eX6sshhN7l-TP4O9aA_euDhcNsr';

        let dbClient = null;
        if (window.supabase && window.supabase.createClient) {
            dbClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        }

        const CLAVE_ACCESO = "sovenap";
        let modoPlan = 'ver';
        let hojaActiva = 'PROD1-SEM1';

        const CLIENTES_PREDETERMINADOS = ["RUI", "Granja Manolo", "Agropecuarios Salvador", "Filamentosa S.L", "Lázaro e Hijos"];

        // CÁLCULO DINÁMICO DE SEMANAS Y FECHAS
        function getISOWeekNumber(d) {
            const date = new Date(d.getTime());
            date.setHours(0, 0, 0, 0);
            date.setDate(date.getDate() + 3 - ((date.getDay() + 6) % 7));
            const week1 = new Date(date.getFullYear(), 0, 4);
            return 1 + Math.round(((date.getTime() - week1.getTime()) / 86400000 - 3 + ((week1.getDay() + 6) % 7)) / 7);
        }

        function getMondayOfWeek(d) {
            const date = new Date(d);
            const day = date.getDay();
            const diff = date.getDate() - day + (day === 0 ? -6 : 1);
            return new Date(date.setDate(diff));
        }

        function getFormattedDatesForWeek(monday) {
            const arr = [];
            for (let i = 0; i < 5; i++) {
                const temp = new Date(monday);
                temp.setDate(monday.getDate() + i);
                const dd = String(temp.getDate()).padStart(2, '0');
                const mm = String(temp.getMonth() + 1).padStart(2, '0');
                arr.push(`${dd}/${mm}`);
            }
            return arr;
        }

        const hoy = new Date();
        const lunesSem1 = getMondayOfWeek(hoy);
        const lunesSem2 = new Date(lunesSem1);
        lunesSem2.setDate(lunesSem1.getDate() + 7);

        const numSem1 = getISOWeekNumber(lunesSem1);
        const numSem2 = getISOWeekNumber(lunesSem2);

        const defFechasSem1 = getFormattedDatesForWeek(lunesSem1);
        const defFechasSem2 = getFormattedDatesForWeek(lunesSem2);

        // LEER CLIENTES REGISTRADOS DESDE cuentas_clientes
        async function getClientesRegistradosOficiales() {
            let list = [...CLIENTES_PREDETERMINADOS];
            if (!dbClient) return list;
            try {
                const res = await Promise.race([
                    dbClient.from('cuentas_clientes').select('nombre'),
                    new Promise(r => setTimeout(() => r({ data: null, error: 'timeout' }), 2000))
                ]);
                if (res && !res.error && Array.isArray(res.data) && res.data.length > 0) {
                    list = res.data.map(r => r.nombre.trim());
                }
                return list;
            } catch(e) { return list; }
        }

        // CARGAR PLANIFICACIÓN Y AUTO-SINCRONIZAR
        async function getPlanificacionData() {
            let data = {};
            try {
                const local = localStorage.getItem('local_planificacion_app');
                if (local) data = JSON.parse(local);
            } catch(e){}

            if (dbClient) {
                try {
                    const res = await Promise.race([
                        dbClient.from('planificacion_pedidos').select('*'),
                        new Promise(r => setTimeout(() => r({ data: null, error: 'timeout' }), 2000))
                    ]);
                    if (res && !res.error && Array.isArray(res.data) && res.data.length > 0) {
                        res.data.forEach(row => {
                            if (row.sheet_key) {
                                data[row.sheet_key] = {
                                    title: row.title,
                                    dates: row.dates,
                                    clients: row.clients
                                };
                            }
                        });
                        localStorage.setItem('local_planificacion_app', JSON.stringify(data));
                    }
                } catch(e) {}
            }

            const clientesOficiales = await getClientesRegistradosOficiales();

            const hojasKeys = [
                { key: "PROD1-SEM1", title: `PROGRAMACIÓN SEMANA ${numSem1} - PRODUCTO 1`, defDates: defFechasSem1 },
                { key: "PROD2-SEM1", title: `PROGRAMACIÓN SEMANA ${numSem1} - PRODUCTO 2`, defDates: defFechasSem1 },
                { key: "PROD3-SEM1", title: `PROGRAMACIÓN SEMANA ${numSem1} - PRODUCTO 3`, defDates: defFechasSem1 },
                { key: "PROD4-SEM1", title: `PROGRAMACIÓN SEMANA ${numSem1} - PRODUCTO 4`, defDates: defFechasSem1 },
                { key: "PROD1-SEM2", title: `PROGRAMACIÓN SEMANA ${numSem2} - PRODUCTO 1`, defDates: defFechasSem2 },
                { key: "PROD2-SEM2", title: `PROGRAMACIÓN SEMANA ${numSem2} - PRODUCTO 2`, defDates: defFechasSem2 },
                { key: "PROD3-SEM2", title: `PROGRAMACIÓN SEMANA ${numSem2} - PRODUCTO 3`, defDates: defFechasSem2 },
                { key: "PROD4-SEM2", title: `PROGRAMACIÓN SEMANA ${numSem2} - PRODUCTO 4`, defDates: defFechasSem2 }
            ];

            hojasKeys.forEach(h => {
                if (!data[h.key]) {
                    data[h.key] = { title: h.title, dates: h.defDates, clients: [] };
                } else {
                    data[h.key].title = h.title;
                    if (!data[h.key].dates || data[h.key].dates.length !== 5) {
                        data[h.key].dates = h.defDates;
                    }
                }

                let syncedClients = [];
                clientesOficiales.forEach(cliNom => {
                    const existente = (data[h.key].clients || []).find(c => c.name.toUpperCase() === cliNom.toUpperCase());
                    if (existente) {
                        syncedClients.push(existente);
                    } else {
                        syncedClients.push({
                            name: cliNom,
                            vals: [0, 0, 0, 0, 0],
                            green: [false, false, false, false, false]
                        });
                    }
                });
                data[h.key].clients = syncedClients;
            });

            return data;
        }

        async function saveSheet(sheetKey, sheetObj) {
            let dataAll = await getPlanificacionData();
            dataAll[sheetKey] = sheetObj;
            try { localStorage.setItem('local_planificacion_app', JSON.stringify(dataAll)); } catch(e){}

            if (!dbClient) return;
            try {
                await dbClient.from('planificacion_pedidos').upsert([{
                    sheet_key: sheetKey,
                    title: sheetObj.title,
                    dates: sheetObj.dates,
                    clients: sheetObj.clients
                }]);
            } catch(e){}
        }

        // ACCESO
        function verificarPin() {
            const val = document.getElementById('input-pin-acceso').value.trim().toLowerCase();
            if (val === CLAVE_ACCESO) {
                sessionStorage.setItem('sesion_plan_activa', 'true');
                document.getElementById('sec-login').classList.add('hidden');
                document.getElementById('sec-planificacion').classList.remove('hidden');
                document.getElementById('btn-logout').classList.remove('hidden');
                renderTabla();
            } else {
                alert('Contraseña incorrecta.');
            }
        }

        function cerrarSesion() {
            sessionStorage.removeItem('sesion_plan_activa');
            document.getElementById('sec-login').classList.remove('hidden');
            document.getElementById('sec-planificacion').classList.add('hidden');
            document.getElementById('btn-logout').classList.add('hidden');
            document.getElementById('input-pin-acceso').value = '';
        }

        function setModo(modo) {
            modoPlan = modo;
            const btnVis = document.getElementById('btn-modo-vis');
            const btnEdit = document.getElementById('btn-modo-edit');
            const btnFechas = document.getElementById('btn-config-fechas');

            if (modo === 'editar') {
                btnEdit.className = "flex-1 sm:flex-none px-5 py-2 rounded-lg text-xs font-bold transition-all bg-blue-600 text-white shadow-md";
                btnVis.className = "flex-1 sm:flex-none px-5 py-2 rounded-lg text-xs font-bold transition-all text-slate-300 hover:text-white";
                btnFechas.classList.remove('hidden');
            } else {
                btnVis.className = "flex-1 sm:flex-none px-5 py-2 rounded-lg text-xs font-bold transition-all bg-blue-600 text-white shadow-md";
                btnEdit.className = "flex-1 sm:flex-none px-5 py-2 rounded-lg text-xs font-bold transition-all text-slate-300 hover:text-white";
                btnFechas.classList.add('hidden');
            }
            renderTabla();
        }

        // RENDERIZADO DE TABLA PRINCIPAL Y RESUMEN
        async function renderTabla() {
            const dataAll = await getPlanificacionData();
            const sheet = dataAll[hojaActiva] || { title: hojaActiva, dates: ["-","-","-","-","-"], clients: [] };
            
            document.getElementById('lbl-plan-titulo-hoja').textContent = sheet.title;

            sheet.dates.forEach((d, idx) => {
                const th = document.getElementById(`th-f${idx + 1}`);
                if (th) th.textContent = `${["LUNES", "MARTES", "MIÉRCOLES", "JUEVES", "VIERNES"][idx]} ${d}`;
            });

            const tbody = document.getElementById('tabla-planificacion-body');
            tbody.innerHTML = '';

            let sumaDia = [0, 0, 0, 0, 0];
            let totalCamionesGlobal = 0;

            sheet.clients.forEach((cli, cIdx) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition-colors border-b border-slate-200";
                let sumRow = 0;
                let celdas = '';

                cli.vals.forEach((v, dIdx) => {
                    const num = Number(v) || 0;
                    sumRow += num;
                    sumaDia[dIdx] += num;
                    const isGreen = cli.green ? cli.green[dIdx] : false;
                    const greenCls = isGreen ? 'cell-green-plan' : '';

                    if (modoPlan === 'editar') {
                        celdas += `
                            <td class="p-2.5 text-center border-r border-slate-200 ${greenCls}">
                                <div class="flex items-center justify-center gap-1">
                                    <input type="number" min="0" data-cidx="${cIdx}" data-didx="${dIdx}" value="${num}" class="input-plan-val w-12 text-center p-1.5 border border-slate-300 rounded-lg text-xs font-bold bg-white outline-none focus:ring-2 focus:ring-blue-500 shadow-sm">
                                    <button data-cidx="${cIdx}" data-didx="${dIdx}" class="btn-toggle-green text-[10px] p-1.5 rounded-lg font-bold border transition-all shadow-sm ${isGreen ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-slate-100 text-slate-500 hover:bg-emerald-100'}">🟢</button>
                                </div>
                            </td>
                        `;
                    } else {
                        celdas += `
                            <td class="p-3.5 text-center font-bold text-slate-800 border-r border-slate-200 ${greenCls}">
                                ${num > 0 ? num : '-'}
                                ${isGreen ? '<span class="text-[10px] block text-emerald-700 font-extrabold mt-0.5">(Pendiente)</span>' : ''}
                            </td>
                        `;
                    }
                });

                totalCamionesGlobal += sumRow;

                tr.innerHTML = `
                    <td class="p-3.5 font-bold border-r border-slate-200 bg-slate-50/50 text-slate-800">${cli.name}</td>
                    ${celdas}
                    <td class="p-3.5 text-center font-extrabold bg-blue-50 text-blue-900 border-r border-slate-200 text-base">${sumRow}</td>
                    <td class="p-3.5 text-center font-extrabold bg-amber-50 text-amber-900 text-base">${sumRow * 25} TM</td>
                `;
                tbody.appendChild(tr);
            });

            // Totales de pie de tabla
            const tfoot = document.getElementById('tabla-planificacion-foot');
            let footDiasCamiones = sumaDia.map(s => `<td class="p-3.5 text-center text-slate-800 border-r border-slate-300 bg-slate-200">${s}</td>`).join('');
            let footDiasTM = sumaDia.map(s => `<td class="p-3.5 text-center border-r border-slate-400 font-extrabold">${s * 25}</td>`).join('');

            tfoot.innerHTML = `
                <tr class="border-b border-slate-300">
                    <td class="p-3.5 text-slate-900 border-r border-slate-300 uppercase">TOTAL CAMIONES</td>
                    ${footDiasCamiones}
                    <td class="p-3.5 text-center text-blue-950 bg-blue-200 border-r border-slate-300 text-base">${totalCamionesGlobal}</td>
                    <td class="p-3.5 text-center text-amber-950 bg-amber-200 text-base">${totalCamionesGlobal * 25} TM</td>
                </tr>
                <tr class="bg-slate-300 text-slate-900">
                    <td class="p-3.5 border-r border-slate-400 font-extrabold uppercase">TOTAL TM (x25)</td>
                    ${footDiasTM}
                    <td class="p-3.5 text-center bg-blue-300 font-extrabold border-r border-slate-400 text-base">${totalCamionesGlobal * 25} TM</td>
                    <td class="p-3.5 text-center bg-amber-300 font-extrabold text-base">${totalCamionesGlobal * 25} TM</td>
                </tr>
            `;

            // RENDERIZAR RESUMEN SEMANAL DINÁMICO
            renderResumenSemanal(dataAll);
        }

        // RENDERIZADO DEL RESUMEN SEMANAL (TODOS LOS PRODUCTOS AGRUPADOS)
        function renderResumenSemanal(dataAll) {
            document.getElementById('lbl-resumen-numsem1').textContent = `${numSem1}`;
            document.getElementById('lbl-resumen-numsem2').textContent = `${numSem2}`;

            const diasNombres = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes"];

            // Cálculo Semana 1
            const fechasSem1 = dataAll['PROD1-SEM1']?.dates || defFechasSem1;
            let sumaDiaSem1 = [0, 0, 0, 0, 0];
            ['PROD1-SEM1', 'PROD2-SEM1', 'PROD3-SEM1', 'PROD4-SEM1'].forEach(k => {
                const hoja = dataAll[k];
                if (hoja && hoja.clients) {
                    hoja.clients.forEach(c => {
                        (c.vals || []).forEach((v, idx) => {
                            sumaDiaSem1[idx] += (Number(v) || 0);
                        });
                    });
                }
            });

            const tbodySem1 = document.getElementById('tabla-resumen-sem1-body');
            tbodySem1.innerHTML = '';
            let totalSem1 = 0;
            sumaDiaSem1.forEach((totalDia, idx) => {
                totalSem1 += totalDia;
                tbodySem1.innerHTML += `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-3 border-r border-slate-200">${diasNombres[idx]} ${fechasSem1[idx]}</td>
                        <td class="p-3 text-center font-bold ${totalDia > 0 ? 'text-blue-700' : 'text-slate-400'}">${totalDia}</td>
                    </tr>
                `;
            });
            document.getElementById('td-total-resumen-sem1').textContent = totalSem1;

            // Cálculo Semana 2
            const fechasSem2 = dataAll['PROD1-SEM2']?.dates || defFechasSem2;
            let sumaDiaSem2 = [0, 0, 0, 0, 0];
            ['PROD1-SEM2', 'PROD2-SEM2', 'PROD3-SEM2', 'PROD4-SEM2'].forEach(k => {
                const hoja = dataAll[k];
                if (hoja && hoja.clients) {
                    hoja.clients.forEach(c => {
                        (c.vals || []).forEach((v, idx) => {
                            sumaDiaSem2[idx] += (Number(v) || 0);
                        });
                    });
                }
            });

            const tbodySem2 = document.getElementById('tabla-resumen-sem2-body');
            tbodySem2.innerHTML = '';
            let totalSem2 = 0;
            sumaDiaSem2.forEach((totalDia, idx) => {
                totalSem2 += totalDia;
                tbodySem2.innerHTML += `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-3 border-r border-slate-200">${diasNombres[idx]} ${fechasSem2[idx]}</td>
                        <td class="p-3 text-center font-bold ${totalDia > 0 ? 'text-blue-700' : 'text-slate-400'}">${totalDia}</td>
                    </tr>
                `;
            });
            document.getElementById('td-total-resumen-sem2').textContent = totalSem2;
        }

        // EVENTOS DE EDICIÓN EN TIEMPO REAL
        document.getElementById('tabla-planificacion-body').addEventListener('change', async (e) => {
            const dataAll = await getPlanificacionData();
            const sheet = dataAll[hojaActiva];
            if (e.target.classList.contains('input-plan-val')) {
                const cIdx = Number(e.target.dataset.cidx);
                const dIdx = Number(e.target.dataset.didx);
                sheet.clients[cIdx].vals[dIdx] = Number(e.target.value) || 0;
                await saveSheet(hojaActiva, sheet);
                renderTabla();
            }
        });

        document.getElementById('tabla-planificacion-body').addEventListener('click', async (e) => {
            const dataAll = await getPlanificacionData();
            const sheet = dataAll[hojaActiva];
            if (e.target.classList.contains('btn-toggle-green')) {
                const cIdx = Number(e.target.dataset.cidx);
                const dIdx = Number(e.target.dataset.didx);
                if (!sheet.clients[cIdx].green) sheet.clients[cIdx].green = [false, false, false, false, false];
                sheet.clients[cIdx].green[dIdx] = !sheet.clients[cIdx].green[dIdx];
                await saveSheet(hojaActiva, sheet);
                renderTabla();
            }
        });

        // CAMBIO DE PESTAÑAS
        document.querySelectorAll('.tab-plan-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.tab-plan-btn').forEach(b => {
                    b.className = "tab-plan-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-600 hover:bg-white/80";
                });
                e.target.className = "tab-plan-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-blue-900 shadow-sm";
                hojaActiva = e.target.dataset.sheet;
                renderTabla();
            });
        });

        // MODAL CONFIGURAR FECHAS
        async function abrirModalFechas() {
            const dataAll = await getPlanificacionData();
            const sheet = dataAll[hojaActiva];
            if (!sheet) return;
            sheet.dates.forEach((d, idx) => {
                document.getElementById(`inp-fecha-${idx}`).value = d;
            });
            document.getElementById('modal-fechas').classList.remove('hidden');
        }

        async function guardarFechasColumnas() {
            const dataAll = await getPlanificacionData();
            const sheet = dataAll[hojaActiva];
            if (sheet) {
                sheet.dates = [
                    document.getElementById('inp-fecha-0').value.trim(),
                    document.getElementById('inp-fecha-1').value.trim(),
                    document.getElementById('inp-fecha-2').value.trim(),
                    document.getElementById('inp-fecha-3').value.trim(),
                    document.getElementById('inp-fecha-4').value.trim()
                ];
                await saveSheet(hojaActiva, sheet);
                document.getElementById('modal-fechas').classList.add('hidden');
                renderTabla();
            }
        }

        // INICIALIZACIÓN
        window.addEventListener('DOMContentLoaded', () => {
            document.getElementById('lbl-tag-sem1').textContent = `Semana ${numSem1}:`;
            document.getElementById('lbl-tag-sem2').textContent = `Semana ${numSem2}:`;

            const btnDark = document.getElementById('btn-toggle-dark');
            btnDark.addEventListener('click', () => {
                document.body.classList.toggle('dark-theme');
                const isDark = document.body.classList.contains('dark-theme');
                localStorage.setItem('plan_dark_mode', isDark ? 'true' : 'false');
                btnDark.innerHTML = isDark ? '☀️ <span class="hidden sm:inline">Modo Claro</span>' : '🌙 <span class="hidden sm:inline">Modo Oscuro</span>';
            });

            if (localStorage.getItem('plan_dark_mode') === 'true') {
                document.body.classList.add('dark-theme');
                btnDark.innerHTML = '☀️ <span class="hidden sm:inline">Modo Claro</span>';
            }

            if (sessionStorage.getItem('sesion_plan_activa') === 'true') {
                document.getElementById('sec-login').classList.add('hidden');
                document.getElementById('sec-planificacion').classList.remove('hidden');
                document.getElementById('btn-logout').classList.remove('hidden');
                renderTabla();
            }
        });
    </script>
</body>
</html>
